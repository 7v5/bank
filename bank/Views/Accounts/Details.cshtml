@model AccountDetailsViewModel
@{
    var a = Model.Account;
    ViewData["Title"] = a.Name;
    var isGoal = a.Type == AccountType.Goal;
    var pct = (int)((a.GoalProgress ?? 0) * 100);
    var results = new TransactionResultsModel(Model.History, Model.Query, "Details", a.Id);
    var rate = (decimal)ViewBag.InterestRate;
    var interestYtd = (decimal)ViewBag.InterestYtd;
    var interestNext = (decimal)ViewBag.InterestNext;
}
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", "icon-sm") All accounts</a>

<div class="acct-detail">
    <section class="acct-hero card card-pad @Ui.AccountTone(a.Type)" aria-labelledby="acct-h">
        <div class="acct-hero-top">
            <span class="acct-tile acct-tile-lg">@Ui.Icon(Ui.AccountIcon(a), "icon-lg")</span>
            <div>
                <h1 id="acct-h">@a.Name</h1>
                <div class="row row-wrap chip-row">
                    <span class="chip chip-acct">@Ui.AccountTypeLabel(a.Type)</span>
                    @if (a.IsPrimary) { <span class="chip chip-primary">@Ui.Icon("star", "icon-sm")Primary</span> }
                    @if (a.IsFrozen) { <span class="chip chip-warn">@Ui.Icon("snowflake", "icon-sm")Frozen</span> }
                    @if (a.LockedByOwner) { <span class="chip chip-warn">@Ui.Icon("lock", "icon-sm")Locked</span> }
                    @if (!a.IsActive) { <span class="chip">Closed @a.ClosedUtc?.ToLocalTime().ToString("MMM d, yyyy")</span> }
                </div>
            </div>
        </div>

        <div class="acct-hero-body">
            <div>
                <span class="muted">@(isGoal ? "Saved so far" : "Available balance")</span>
                <div class="acct-hero-balance num">@Money.Format(a.Balance)</div>
                <div class="acct-number">
                    <span class="muted">Account number</span>
                    <span class="num" id="acct-num" data-full="@a.AccountNumber" data-masked="@a.MaskedNumber">@a.MaskedNumber</span>
                    <button type="button" class="btn btn-ghost btn-sm" data-reveal="acct-num" aria-pressed="false" aria-label="Show full account number">@Ui.Icon("eye", "icon-sm")<span data-reveal-label>Show</span></button>
                    <button type="button" class="btn btn-ghost btn-sm" data-copy="@a.AccountNumber" data-copy-label="Account number copied">@Ui.Icon("copy", "icon-sm")Copy</button>
                </div>
            </div>
            @if (isGoal)
            {
                <div class="goal-box">
                    <span class="muted">Goal progress</span>
                    <strong class="num">@pct%</strong>
                    <span class="progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="Goal progress"><span style="width:@pct%"></span></span>
                    <small class="num">@Money.Format(a.Balance) of @Money.Format(a.GoalAmount ?? 0)</small>
                </div>
            }
        </div>

        @if (a.IsFrozen)
        {
            <div class="alert alert-warn">@Ui.Icon("snowflake")<span>The bank has frozen this account. You can still receive money, but you can't send or withdraw from it.</span></div>
        }
        @if (a.LockedByOwner && a.IsActive)
        {
            <div class="alert alert-warn">@Ui.Icon("lock")
                <span>You locked this account. Money can come in, but nothing can leave it until you unlock it.</span>
                <form asp-action="SetLock" asp-route-id="@a.Id" method="post" class="alert-action"><input type="hidden" name="locked" value="false" /><button type="submit" class="btn btn-secondary btn-sm">@Ui.Icon("unlock", "icon-sm")Unlock account</button></form>
            </div>
        }

        @if (a.IsActive)
        {
            <div class="acct-actions">
                <a class="btn btn-primary" asp-controller="Money" asp-action="Deposit" asp-route-accountId="@a.Id">@Ui.Icon("arrow-down", "icon-sm")Deposit</a>
                <a class="btn btn-secondary" asp-controller="Money" asp-action="Withdraw" asp-route-accountId="@a.Id">@Ui.Icon("cash", "icon-sm")Withdraw</a>
                <a class="btn btn-secondary" asp-controller="Money" asp-action="Transfer" asp-route-from="@a.Id">@Ui.Icon("arrow-up-right", "icon-sm")Transfer out</a>
                <a class="btn btn-secondary" asp-controller="Money" asp-action="Transfer" asp-route-to="@a.Id">@Ui.Icon("arrow-down", "icon-sm")Transfer in</a>
                <a class="btn btn-secondary" asp-action="Statement" asp-route-id="@a.Id">@Ui.Icon("receipt", "icon-sm")Statements</a>
                <button type="button" class="btn btn-ghost" data-drawer-open="acct-settings" aria-controls="acct-settings">@Ui.Icon("sliders", "icon-sm")Account settings</button>
            </div>
        }
    </section>

    <aside class="acct-stats" aria-label="Account summary">
        <div class="card card-pad stat">
            <span class="muted">Money in, last 30 days</span>
            <strong class="num @(Model.In30 > 0 ? "pos" : "")">@(Model.In30 == 0 ? Money.Format(0) : "+" + Money.Format(Model.In30))</strong>
        </div>
        <div class="card card-pad stat">
            <span class="muted">Money out, last 30 days</span>
            <strong class="num">@(Model.Out30 == 0 ? Money.Format(0) : "−" + Money.Format(Model.Out30))</strong>
        </div>
        @if (rate > 0)
        {
            <div class="card card-pad stat">
                <span class="muted">Interest, @Ui.Rate(rate) a year</span>
                <strong class="num @(interestYtd > 0 ? "pos" : "")">@(interestYtd > 0 ? "+" + Money.Format(interestYtd) : Money.Format(0))</strong>
                <small class="muted">Paid this year. About @Money.Format(interestNext) next month at today's balance.</small>
            </div>
        }
        <div class="card card-pad stat">
            <span class="muted">Opened</span>
            <strong>@a.OpenedUtc.ToLocalTime().ToString("MMMM d, yyyy", Money.Culture)</strong>
        </div>
    </aside>
</div>

<section class="card card-pad mt-5" aria-labelledby="hist-h">
    <div class="card-head">
        <h2 id="hist-h">Transactions</h2>
        <a class="link" asp-controller="Transactions" asp-action="Index" asp-route-accountId="@a.Id">Search and filter in Activity</a>
    </div>
    <div data-results-host>
        <partial name="_TransactionResults" model="results" />
    </div>
</section>

<partial name="_TxDrawer" />

@if (a.IsActive)
{
    <div class="drawer" id="acct-settings" role="dialog" aria-modal="true" aria-labelledby="settings-h" aria-hidden="true">
        <div><div class="sheet-grip"></div>
            <div class="drawer-head"><h2 id="settings-h">Account settings</h2><button type="button" class="icon-btn" data-drawer-close aria-label="Close settings">@Ui.Icon("x")</button></div>
        </div>
        <div class="drawer-body stack">
            <form asp-action="Rename" asp-route-id="@a.Id" method="post" class="form">
                <div class="field">
                    <label for="Name">Account name</label>
                    <input id="Name" name="Name" class="input" value="@a.Name" maxlength="60" required />
                </div>
                @if (isGoal)
                {
                    <div class="field">
                        <label for="GoalAmount">Goal target</label>
                        <div class="input-wrap">
                            <span class="handle-at" aria-hidden="true">$</span>
                            <input id="GoalAmount" name="GoalAmount" class="input num input-dollar" inputmode="decimal" value="@a.GoalAmount?.ToString("0.00")" required />
                        </div>
                    </div>
                }
                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>

            @if (!a.IsPrimary && !isGoal)
            {
                <div class="setting-row">
                    <div><strong>Make this your primary account</strong><p class="muted">Money people send you will go into this account.</p></div>
                    <form asp-action="MakePrimary" asp-route-id="@a.Id" method="post"><button type="submit" class="btn btn-secondary btn-sm">Make primary</button></form>
                </div>
            }

            <div class="setting-row">
                <div>
                    <strong>@(a.LockedByOwner ? "Unlock this account" : "Lock this account")</strong>
                    <p class="muted">@(a.LockedByOwner ? "Payments, transfers and withdrawals from this account will work again." : "Stops all payments, transfers and withdrawals from this account until you unlock it. Money can still come in.")</p>
                </div>
                <form asp-action="SetLock" asp-route-id="@a.Id" method="post">
                    <input type="hidden" name="locked" value="@(a.LockedByOwner ? "false" : "true")" />
                    @if (a.LockedByOwner)
                    {
                        <button type="submit" class="btn btn-secondary btn-sm">@Ui.Icon("unlock", "icon-sm")Unlock account</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-secondary btn-sm" data-confirm-title="Lock @a.Name?" data-confirm="No money will be able to leave this account, including scheduled payments, until you unlock it." data-confirm-ok="Lock account">@Ui.Icon("lock", "icon-sm")Lock account</button>
                    }
                </form>
            </div>

            <div class="setting-row danger">
                <div>
                    <strong>Close account</strong>
                    <p class="muted">@(a.Balance != 0 ? $"Move the {Money.Format(a.Balance)} out first. The balance must be $0.00 to close." : "Closed accounts keep their history. This can't be undone.")</p>
                </div>
                <form asp-action="Close" asp-route-id="@a.Id" method="post">
                    <button type="submit" class="btn btn-danger btn-sm" disabled="@(a.Balance != 0)"
                            data-confirm-title="Close @a.Name?" data-confirm="The account will be closed for good. Its history stays in Activity. This can't be undone." data-confirm-ok="Close account">
                        @Ui.Icon("trash", "icon-sm")Close account
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="module" src="~/js/transactions.js" asp-append-version="true"></script>
}
