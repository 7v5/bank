@model AccountDetailsViewModel
@{
    var a = Model.Account;
    ViewData["Title"] = a.Name;
    var isGoal = a.Type == AccountType.Goal;
    var pct = (int)((a.GoalProgress ?? 0) * 100);
    var results = new TransactionResultsModel(Model.History, Model.Query, "Details", a.Id);
}
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", "icon-sm") All accounts</a>

<div class="acct-detail">
    <section class="acct-hero card card-pad">
        <div class="acct-hero-top">
            <span class="acct-icon acct-icon-lg">@Ui.Icon(isGoal ? "target" : Ui.AccountIcon(a), "icon-lg")</span>
            <div>
                <h1>@a.Name</h1>
                <div class="row row-wrap" style="gap:6px;margin-top:6px">
                    <span class="chip">@Ui.AccountTypeLabel(a.Type)</span>
                    @if (a.IsPrimary) { <span class="chip chip-primary">@Ui.Icon("star", "icon-sm")Primary</span> }
                    @if (a.IsFrozen) { <span class="chip chip-warn">@Ui.Icon("snowflake", "icon-sm")Frozen</span> }
                    @if (!a.IsActive) { <span class="chip">Closed @a.ClosedUtc?.ToLocalTime().ToString("MMM d, yyyy")</span> }
                </div>
            </div>
        </div>

        <div class="acct-hero-body">
            <div>
                <span class="muted">Available balance</span>
                <div class="acct-hero-balance num" data-countup="@a.Balance">@Money.Format(a.Balance)</div>
                <div class="acct-number">
                    <span class="muted">Account number</span>
                    <span class="num" id="acct-num" data-full="@a.AccountNumber" data-masked="@a.MaskedNumber">@a.MaskedNumber</span>
                    <button type="button" class="btn btn-ghost btn-icon btn-sm" data-reveal="acct-num" aria-pressed="false" aria-label="Show account number">@Ui.Icon("eye", "icon-sm")</button>
                    <button type="button" class="btn btn-ghost btn-icon btn-sm" data-copy="@a.AccountNumber" data-copy-label="Account number copied" aria-label="Copy account number">@Ui.Icon("copy", "icon-sm")</button>
                </div>
            </div>
            @if (isGoal)
            {
                <div class="goal-ring" style="--p:@pct" role="img" aria-label="@pct percent of goal">
                    <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" class="track" /><circle cx="60" cy="60" r="52" class="fill" pathLength="100" /></svg>
                    <div><strong class="num">@pct%</strong><small class="muted">of @Money.Format(a.GoalAmount ?? 0)</small></div>
                </div>
            }
        </div>

        @if (a.IsFrozen)
        {
            <div class="alert alert-warn">@Ui.Icon("snowflake")<span>This account has been frozen by the bank. You can still receive money, but you can't send or withdraw from it.</span></div>
        }

        @if (a.IsActive)
        {
            <div class="acct-actions">
                <a class="btn btn-primary" asp-controller="Money" asp-action="Deposit" asp-route-accountId="@a.Id">@Ui.Icon("arrow-down", "icon-sm")Deposit</a>
                <a class="btn btn-secondary" asp-controller="Money" asp-action="Withdraw" asp-route-accountId="@a.Id">@Ui.Icon("cash", "icon-sm")Withdraw</a>
                <a class="btn btn-secondary" asp-controller="Money" asp-action="Transfer" asp-route-from="@a.Id">@Ui.Icon("swap", "icon-sm")Move out</a>
                <a class="btn btn-secondary" asp-controller="Money" asp-action="Transfer" asp-route-to="@a.Id">@Ui.Icon("arrow-down", "icon-sm")Move in</a>
                <button type="button" class="btn btn-ghost" data-drawer-open="acct-settings">@Ui.Icon("sliders", "icon-sm")Settings</button>
            </div>
        }
    </section>

    <aside class="acct-stats">
        <div class="card card-pad stat">
            <span class="muted">In, last 30 days</span>
            <strong class="num pos" data-countup="@Model.In30">@Money.Format(Model.In30)</strong>
        </div>
        <div class="card card-pad stat">
            <span class="muted">Out, last 30 days</span>
            <strong class="num" data-countup="@Model.Out30">@Money.Format(Model.Out30)</strong>
        </div>
        <div class="card card-pad stat">
            <span class="muted">Opened</span>
            <strong>@a.OpenedUtc.ToLocalTime().ToString("MMMM d, yyyy", Money.Culture)</strong>
        </div>
    </aside>
</div>

<section class="card card-pad" aria-labelledby="hist-h" style="margin-top:var(--space-5)">
    <div class="card-head">
        <h2 id="hist-h">Activity</h2>
        <a class="link" asp-controller="Transactions" asp-action="Index" asp-route-accountId="@a.Id">Filter and search</a>
    </div>
    <div data-results-host>
        <partial name="_TransactionResults" model="results" />
    </div>
</section>

<partial name="_TxDrawer" />

@if (a.IsActive)
{
    <div class="drawer" id="acct-settings" role="dialog" aria-modal="true" aria-labelledby="settings-h" aria-hidden="true">
        <div><div class="sheet-grip"></div>
            <div class="drawer-head"><h2 id="settings-h">Account settings</h2><button type="button" class="icon-btn" data-drawer-close aria-label="Close">@Ui.Icon("x")</button></div>
        </div>
        <div class="drawer-body stack">
            <form asp-action="Rename" asp-route-id="@a.Id" method="post" class="form">
                <div class="field">
                    <label for="Name">Account name</label>
                    <input id="Name" name="Name" class="input" value="@a.Name" maxlength="60" required />
                </div>
                @if (isGoal)
                {
                    <div class="field">
                        <label for="GoalAmount">Goal target</label>
                        <input id="GoalAmount" name="GoalAmount" class="input num" inputmode="decimal" value="@a.GoalAmount?.ToString("0.00")" required />
                    </div>
                }
                <button type="submit" class="btn btn-primary">Save changes</button>
            </form>

            @if (!a.IsPrimary && !isGoal)
            {
                <div class="setting-row">
                    <div><strong>Make primary</strong><p class="muted">Money people send you will land in this account.</p></div>
                    <form asp-action="MakePrimary" asp-route-id="@a.Id" method="post"><button type="submit" class="btn btn-secondary btn-sm">Make primary</button></form>
                </div>
            }

            <div class="setting-row danger">
                <div><strong>Close account</strong><p class="muted">The balance must be $0.00 first. Closed accounts keep their history.</p></div>
                <form asp-action="Close" asp-route-id="@a.Id" method="post">
                    <button type="submit" class="btn btn-soft-danger btn-sm" data-confirm="Close @a.Name? This can't be undone." disabled="@(a.Balance != 0)">Close account</button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="module" src="~/js/transactions.js" asp-append-version="true"></script>
}
