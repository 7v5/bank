@model List<BankAccount>
@{
    ViewData["Title"] = "Accounts";
    var open = Model.Where(a => a.IsActive).ToList();
    var closed = Model.Where(a => !a.IsActive).ToList();
    var total = open.Sum(a => a.Balance);
}
<div class="page-head">
    <div>
        <h1>Accounts</h1>
        <p><span class="num">@Money.Format(total)</span> across @open.Count open @(open.Count == 1 ? "account" : "accounts").</p>
    </div>
    <a class="btn btn-primary" asp-action="Open">@Ui.Icon("plus", "icon-sm")Open account</a>
</div>

<div class="acct-grid">
    @foreach (var a in open) { <partial name="_AccountCard" model="a" /> }
    <a class="acct-card acct-new" asp-action="Open">
        <span class="acct-icon">@Ui.Icon("plus")</span>
        <span class="acct-name">Open a new account</span>
        <span class="muted">Checking, savings, or a goal to save toward.</span>
    </a>
</div>

@if (closed.Count > 0)
{
    <details class="closed-accounts">
        <summary>@Ui.Icon("chevron-right", "icon-sm") @closed.Count closed @(closed.Count == 1 ? "account" : "accounts")</summary>
        <div class="acct-grid">
            @foreach (var a in closed) { <partial name="_AccountCard" model="a" /> }
        </div>
    </details>
}
