@{
    var code = (int)(ViewBag.Code ?? 404);
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="status-page">
    <div class="empty-icon status-icon">@Ui.Icon(code == 404 ? "search" : "alert", "icon-lg")</div>
    <p class="status-code num">@code</p>
    <h1>@(code == 404 ? "We couldn't find that page" : code == 429 ? "Slow down a little" : "Something went wrong")</h1>
    <p class="muted">@(code == 404 ? "The link may be old, or the page may have moved." : code == 429 ? "Too many attempts in a short time. Wait a minute, then try again." : "Try again in a moment.")</p>
    <a class="btn btn-primary" href="/">Go to the home page</a>
</div>
