@model MoneyFormViewModel
@{
    var (title, lede, cta, done) = Model.Kind switch
    {
        MoneyKind.Deposit => ("Deposit money", $"Add money to one of your accounts. Up to {Money.Format(BankingService.MaxCashAmount)} per deposit.", "Deposit", "deposit"),
        MoneyKind.Withdraw => ("Withdraw cash", $"Take money out of an account. Up to {Money.Format(BankingService.MaxCashAmount)} per withdrawal.", "Withdraw", "withdraw"),
        MoneyKind.Transfer => ("Transfer between accounts", "Move money between your own accounts. Transfers are instant.", "Transfer", "transfer"),
        _ => ("Send money", "Pay anyone with a SimpleBank account using their handle or email.", "Send", "send"),
    };
    ViewData["Title"] = title;
    var reviewLabel = Model.Kind switch
    {
        MoneyKind.Send => "Review payment",
        MoneyKind.Deposit => "Review deposit",
        MoneyKind.Withdraw => "Review withdrawal",
        _ => "Review transfer"
    };
    var needsFrom = Model.Kind is MoneyKind.Withdraw or MoneyKind.Transfer or MoneyKind.Send;
    var needsTo = Model.Kind is MoneyKind.Deposit or MoneyKind.Transfer;
    var remaining = BankingService.DailySendLimit - Model.SentToday;
    var quick = Model.Kind switch
    {
        MoneyKind.Deposit or MoneyKind.Withdraw => new[] { 20m, 50m, 100m, 500m },
        MoneyKind.Send => new[] { 10m, 25m, 50m, 100m },
        _ => new[] { 50m, 100m, 250m, 1000m }
    };
    var sendHint = Model.Kind == MoneyKind.Send
        ? $"You can send {Money.Format(Math.Max(0, remaining))} more today. The limit is {Money.Format(BankingService.DailySendLimit)} per 24 hours."
        : null;
}
<a class="back-link" asp-controller="Money" asp-action="Index">@Ui.Icon("arrow-left", "icon-sm") Move money</a>

<div class="narrow flow" data-flow="@done">
    <div class="page-head">
        <div><h1>@title</h1><p>@lede</p></div>
    </div>

    <partial name="_FlowSteps" model='new FlowStepsModel(["Details", "Review", "Done"])' />

    <form asp-action="@Model.Kind" method="post" class="card flow-card" novalidate data-money-form data-no-loading>
        <input type="hidden" asp-for="IdempotencyKey" />

        @* ---------- Step 1: details ---------- *@
        <div class="flow-step" data-step="1">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>

            @if (Model.Kind == MoneyKind.Send)
            {
                <div class="field recipient-field">
                    <label for="Recipient">To</label>
                    <div class="recipient-picked" data-recipient-picked hidden="@(Model.RecipientUser is null)">
                        @if (Model.RecipientUser is { } ru)
                        {
                            <span class="avatar" style="--c:@ru.AvatarColor">@ru.Initials</span>
                            <span><strong>@ru.FullName</strong><small class="muted">@@@ru.Handle</small></span>
                        }
                        <button type="button" class="btn btn-ghost btn-sm" data-recipient-clear>Change</button>
                    </div>
                    <div class="input-wrap recipient-search" data-recipient-search hidden="@(Model.RecipientUser is not null)">
                        @Ui.Icon("search")
                        <input asp-for="Recipient" class="input" placeholder="Search by name, &#64;handle or email" autocomplete="off" autocapitalize="off" spellcheck="false"
                               role="combobox" aria-expanded="false" aria-controls="recipient-results" aria-autocomplete="list" />
                        <ul class="recipient-results popover" id="recipient-results" role="listbox"></ul>
                    </div>
                    <span asp-validation-for="Recipient" class="field-error"></span>
                </div>
            }

            <partial name="_AmountField" model="new AmountFieldModel(Model.Amount, quick, sendHint)" />

            <div class="acct-picks @(needsFrom && needsTo ? "two" : "")">
                @if (needsFrom)
                {
                    <partial name="_AccountPicker" model='new AccountPickerModel("FromAccountId", "From", Model.Accounts, Model.FromAccountId, FrozenText: "Frozen, can&#39;t send from it")' />
                }
                @if (needsTo)
                {
                    <partial name="_AccountPicker" model='new AccountPickerModel("ToAccountId", "To", Model.Accounts, Model.ToAccountId, BlockFrozen: false)' />
                }
            </div>

            @if (Model.Kind == MoneyKind.Transfer)
            {
                <partial name="_ScheduleFields" model="Model" />
            }

            <div class="field">
                <label asp-for="Memo">@(Model.Kind == MoneyKind.Send ? "What's it for?" : "Note") <span class="optional">(optional)</span></label>
                <input asp-for="Memo" class="input" maxlength="140" placeholder="@(Model.Kind == MoneyKind.Send ? "For example, pizza night" : "Add a note for your records")" />
                @if (Model.Kind == MoneyKind.Send) { <span class="hint">The person you pay will see this note.</span> }
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-block" data-to-review>@reviewLabel</button>
        </div>

        @* ---------- Step 2: review (shown by money-flow.js) ---------- *@
        <div class="flow-step" data-step="2" hidden>
            <div class="review">
                <span class="muted">Check the details. Nothing moves until you confirm.</span>
                <div class="review-amount num" data-review-amount>$0.00</div>
                <dl class="detail-list">
                    @if (Model.Kind == MoneyKind.Send) { <dt>To</dt><dd data-review-recipient></dd> }
                    @if (needsFrom) { <dt>From</dt><dd data-review-from></dd> }
                    @if (needsTo) { <dt>@(Model.Kind == MoneyKind.Deposit ? "Into" : "To")</dt><dd data-review-to></dd> }
                    <dt>Note</dt><dd data-review-memo></dd>
                    <dt data-review-now data-review-after-label>Balance after</dt><dd class="num" data-review-now data-review-after></dd>
                    <dt data-review-later hidden>When</dt><dd data-review-later data-review-when hidden></dd>
                </dl>
            </div>
            <div class="flow-actions">
                <button type="button" class="btn btn-secondary btn-lg" data-back>@Ui.Icon("arrow-left", "icon-sm")Edit details</button>
                <button type="submit" class="btn btn-primary btn-lg" data-confirm-submit><span data-review-now>@cta</span><span data-review-later hidden>Schedule</span> <span class="num" data-cta-amount></span></button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script type="module" src="~/js/money-flow.js" asp-append-version="true"></script>
}
