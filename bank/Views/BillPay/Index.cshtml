@model List<Payee>
@inject TimeProvider Clock
@{
    ViewData["Title"] = "Bill pay";
    var last = (Dictionary<string, DateTime>)ViewBag.LastPaid;
    var now = Clock.GetUtcNow().UtcDateTime;
}
<div class="page-head">
    <div><h1>Bill pay</h1><p>Your saved payees. Pay any of them from any account, and the payment posts right away.</p></div>
    <div class="row">
        <a class="btn btn-secondary" asp-action="AddPayee">@Ui.Icon("plus", "icon-sm")Add payee</a>
        <a class="btn btn-primary" asp-action="Pay">@Ui.Icon("receipt", "icon-sm")Pay a bill</a>
    </div>
</div>
@if (Model.Count == 0)
{
    <div class="card empty">
        <div class="empty-icon">@Ui.Icon("receipt")</div>
        <h3>No payees yet</h3>
        <p>Add the companies you pay, like your utility or internet provider.</p>
        <a class="btn btn-primary" asp-action="AddPayee">Add a payee</a>
    </div>
}
else
{
    <section class="card payee-list" aria-labelledby="payees-h">
        <div class="panel-head"><h2 id="payees-h">Saved payees</h2><span class="muted">@Model.Count @(Model.Count == 1 ? "payee" : "payees")</span></div>
        @foreach (var p in Model)
        {
            <article class="payee">
                <span class="tx-icon cat-@p.Category">@Ui.Icon(Ui.CategoryIcon(p.Category))</span>
                <div class="payee-main">
                    <strong>@p.Name</strong>
                    <span class="muted num">Reference @p.AccountReference</span>
                    <span class="muted payee-last">@(last.TryGetValue(p.Name, out var when) ? $"Last paid {Ui.Ago(when, now)}" : "Not paid yet")</span>
                </div>
                <div class="payee-actions">
                    <a class="btn btn-primary btn-sm" asp-action="Pay" asp-route-id="@p.Id" aria-label="Pay @p.Name">Pay</a>
                    <form asp-action="DeletePayee" asp-route-id="@p.Id" method="post">
                        <button type="submit" class="btn btn-danger btn-icon btn-sm" aria-label="Remove @p.Name" data-tip="Remove payee"
                                data-confirm-title="Remove @p.Name?" data-confirm="You won't be able to pay @p.Name until you add them again. Past payments stay in Activity." data-confirm-ok="Remove payee">@Ui.Icon("trash", "icon-sm")</button>
                    </form>
                </div>
            </article>
        }
    </section>
}
