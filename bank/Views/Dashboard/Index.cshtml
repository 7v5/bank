@model DashboardViewModel
@inject TimeProvider Clock
@{
    ViewData["Title"] = "Home";
    var now = Clock.GetUtcNow().UtcDateTime;
    var change = Model.BalanceChange30d;
    var positiveTotal = Model.Accounts.Where(a => a.Balance > 0).Sum(a => a.Balance);
}
<h1 class="sr-only">Home</h1>

<div class="dash">
    @* ---------- Total balance: solid claret panel with the still rosette ---------- *@
    <section class="balance-panel dash-total" aria-labelledby="total-h" data-live-total="@Model.Total">
        <svg class="rosette" viewBox="-100 -100 200 200" aria-hidden="true">@Ui.Rosette()</svg>
        <span class="balance-frame" aria-hidden="true"></span>
        <h2 class="balance-label" id="total-h">Total balance, @Model.Accounts.Count @(Model.Accounts.Count == 1 ? "account" : "accounts")</h2>
        <p class="balance-amount num">$<span data-total-dollars>@Ui.Dollars(Model.Total)</span><span class="cents" data-total-cents>.@Ui.Cents(Model.Total)</span></p>
        <p class="balance-meta">
            @if (change is not null)
            {
                <span class="balance-change">@Ui.Icon(change >= 0 ? "arrow-up-right" : "arrow-down", "icon-sm")@Money.Signed(change.Value) in the last 30 days</span>
            }
            <span>As of @now.ToLocalTime().ToString("MMM d, h:mm tt", Money.Culture)</span>
        </p>
        @if (positiveTotal > 0 && Model.Accounts.Count > 1)
        {
            <div class="split" role="img" aria-label="How your total is split: @string.Join(", ", Model.Accounts.Where(a => a.Balance > 0).Select(a => $"{a.Name} {(int)Math.Round(a.Balance / positiveTotal * 100)} percent"))">
                @foreach (var a in Model.Accounts.Where(a => a.Balance > 0))
                {
                    <span class="@Ui.AccountTone(a.Type)" style="flex:@((a.Balance / positiveTotal).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))"></span>
                }
            </div>
            <ul class="split-legend">
                @foreach (var a in Model.Accounts.Where(a => a.Balance > 0))
                {
                    <li class="@Ui.AccountTone(a.Type)"><i aria-hidden="true"></i>@a.Name</li>
                }
            </ul>
        }
        <div class="balance-actions">
            <a class="pa pa-main" asp-controller="Money" asp-action="Send">@Ui.Icon("send", "icon-sm")Send money</a>
            <a class="pa" asp-controller="Money" asp-action="Transfer">@Ui.Icon("swap", "icon-sm")Transfer</a>
            <a class="pa" asp-controller="Money" asp-action="Deposit">@Ui.Icon("arrow-down", "icon-sm")Deposit</a>
            <a class="pa" asp-controller="BillPay" asp-action="Pay">@Ui.Icon("receipt", "icon-sm")Pay a bill</a>
        </div>
    </section>

    @* ---------- Accounts ---------- *@
    <section class="card dash-accounts" aria-labelledby="acc-h">
        <div class="panel-head">
            <h2 id="acc-h">Your accounts</h2>
            <a asp-controller="Accounts" asp-action="Index">View all accounts</a>
        </div>
        <div class="acct-rows">
            @foreach (var a in Model.Accounts) { <partial name="_AccountRow" model="a" /> }
        </div>
        <div class="panel-foot">
            <a class="btn btn-ghost btn-sm" asp-controller="Accounts" asp-action="Open">@Ui.Icon("plus", "icon-sm")Open a new account</a>
        </div>
    </section>

    @* ---------- This month ---------- *@
    <section class="card card-pad dash-month" aria-labelledby="month-h">
        <div class="card-head"><h2 id="month-h">@now.ToLocalTime().ToString("MMMM", Money.Culture) so far</h2></div>
        <div class="month-flow">
            <div>
                <span class="month-label">@Ui.Icon("arrow-down", "icon-sm")Money in</span>
                <span class="month-value num @(Model.MonthIn > 0 ? "pos" : "")">@(Model.MonthIn == 0 ? Money.Format(0) : "+" + Money.Format(Model.MonthIn))</span>
            </div>
            <div>
                <span class="month-label">@Ui.Icon("arrow-up", "icon-sm")Money out</span>
                <span class="month-value num">@(Model.MonthOut == 0 ? Money.Format(0) : "−" + Money.Format(Model.MonthOut))</span>
            </div>
        </div>
        @{ var flowTotal = Model.MonthIn + Model.MonthOut; var inPct = flowTotal == 0 ? 50 : (int)(Model.MonthIn / flowTotal * 100); }
        <div class="flow-bar" role="img" aria-label="Money in is @inPct percent of all money moved this month">
            <span class="in" style="width:@inPct%"></span><span class="out"></span>
        </div>
        <p class="muted month-note">
            @if (Model.MonthIn >= Model.MonthOut) { <text>@Money.Format(Model.MonthIn - Model.MonthOut) more came in than went out.</text> }
            else { <text>@Money.Format(Model.MonthOut - Model.MonthIn) more went out than came in.</text> }
        </p>
    </section>

    @* ---------- Charts ---------- *@
    <section class="card card-pad dash-balance" aria-labelledby="bal-h">
        <div class="card-head">
            <h2 id="bal-h">Total balance over time</h2>
            <div class="segmented" role="tablist" aria-label="Time range" data-range-for="balance-chart">
                <button type="button" role="tab" data-value="30" aria-selected="true">30 days</button>
                <button type="button" role="tab" data-value="90" aria-selected="false">90 days</button>
                <button type="button" role="tab" data-value="180" aria-selected="false">6 months</button>
            </div>
        </div>
        <div class="chart-box chart-tall"><div class="skeleton chart-skeleton"></div><canvas id="balance-chart" aria-label="Line chart of your total balance over time" role="img"></canvas></div>
    </section>

    <section class="card card-pad dash-spend" aria-labelledby="spend-h">
        <div class="card-head">
            <h2 id="spend-h">Spending this month</h2>
            <a class="link" asp-controller="Transactions" asp-action="Index" asp-route-flow="out">View spending</a>
        </div>
        <div class="donut-wrap">
            <div class="chart-box chart-donut"><div class="skeleton chart-skeleton"></div><canvas id="spend-chart" aria-label="Donut chart of spending by category" role="img"></canvas>
                <div class="donut-center"><span class="muted">Spent</span><strong class="num" data-spend-total>—</strong></div>
            </div>
            <ul class="legend" data-spend-legend></ul>
        </div>
    </section>

    <section class="card card-pad dash-recent" aria-labelledby="recent-h">
        <div class="card-head">
            <h2 id="recent-h">Recent activity</h2>
            <a class="link" asp-controller="Transactions" asp-action="Index">View all activity</a>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <div class="empty"><div class="empty-icon">@Ui.Icon("list")</div><h3>No activity yet</h3><p>Make your first deposit to get started.</p><a class="btn btn-primary" asp-controller="Money" asp-action="Deposit">Deposit money</a></div>
        }
        else
        {
            <ul class="tx-list">
                @foreach (var t in Model.Recent) { <partial name="_TransactionRow" model="t" view-data='new ViewDataDictionary(ViewData) { ["ShowAccount"] = true }' /> }
            </ul>
        }
    </section>

    <div class="dash-side">
        @if (Model.PendingIncoming.Count > 0)
        {
            <section class="card card-pad" aria-labelledby="req-h">
                <div class="card-head">
                    <h2 id="req-h">Waiting on you</h2>
                    <a class="link" asp-controller="Requests" asp-action="Index">View all requests</a>
                </div>
                <ul class="req-mini">
                    @foreach (var r in Model.PendingIncoming)
                    {
                        <li>
                            <span class="avatar avatar-sm" style="--c:@r.Requester.AvatarColor" aria-hidden="true">@r.Requester.Initials</span>
                            <div class="req-mini-main">
                                <strong>@r.Requester.FirstName asked for <span class="num">@Money.Format(r.Amount)</span></strong>
                                <small class="muted">@(r.Note ?? "No note"), @Ui.Ago(r.CreatedUtc, now)</small>
                            </div>
                            <a class="btn btn-primary btn-sm" asp-controller="Requests" asp-action="Pay" asp-route-id="@r.Id" aria-label="Pay @r.Requester.FirstName @Money.Format(r.Amount)">Pay</a>
                        </li>
                    }
                </ul>
            </section>
        }
        <section class="card card-pad" aria-labelledby="up-h">
            <div class="card-head">
                <h2 id="up-h">Upcoming payments</h2>
                <a class="link" asp-controller="Scheduled" asp-action="Index">View scheduled payments</a>
            </div>
            @if (Model.Upcoming.Count == 0)
            {
                <p class="muted">Nothing is scheduled.</p>
                <a class="btn btn-secondary btn-sm" asp-controller="Money" asp-action="Transfer">@Ui.Icon("calendar", "icon-sm")Schedule a transfer</a>
            }
            else
            {
                <div class="sched-compact">@foreach (var s in Model.Upcoming) { <partial name="_ScheduleRow" model="s" /> }</div>
            }
        </section>
        <section class="card card-pad" aria-labelledby="budget-h">
            <div class="card-head">
                <h2 id="budget-h">Budgets this month</h2>
                <a class="link" asp-controller="Budgets" asp-action="Index">@(Model.Budgets.Count == 0 ? "Set a budget" : "Manage budgets")</a>
            </div>
            @if (Model.Budgets.Count == 0)
            {
                <p class="muted">Set a monthly limit for groceries, dining or any other kind of spending, and track it here.</p>
            }
            else
            {
                <div class="budget-list budget-compact">@foreach (var b in Model.Budgets.Take(4)) { <partial name="_BudgetRow" model="b" /> }</div>
            }
        </section>
        <section class="card card-pad" aria-labelledby="flow-h">
            <div class="card-head"><h2 id="flow-h">Money in and out, last 6 months</h2></div>
            <div class="chart-box chart-mid"><div class="skeleton chart-skeleton"></div><canvas id="cashflow-chart" aria-label="Bar chart of money in and money out per month" role="img"></canvas></div>
        </section>
    </div>
</div>

<partial name="_TxDrawer" />

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script type="module" src="~/js/dashboard.js" asp-append-version="true"></script>
    <script type="module" src="~/js/transactions.js" asp-append-version="true"></script>
}
