@{
    ViewData["Title"] = "No access";
    Layout = "_AuthLayout";
}
<div class="auth-card">
    <div class="empty-icon status-icon">@Ui.Icon("lock", "icon-lg")</div>
    <h1>You don't have access to that page</h1>
    <p class="auth-lede">It's only available to administrators. If you think this is wrong, sign in with a different account.</p>
    <div class="row row-wrap">
        <a class="btn btn-primary" href="/">Go to my home page</a>
        <form asp-action="Logout" method="post"><button class="btn btn-secondary" type="submit">Sign out and switch account</button></form>
    </div>
</div>
