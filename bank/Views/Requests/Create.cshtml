@model SimpleBankMvc.Controllers.RequestMoneyViewModel
@{
    ViewData["Title"] = "Request money";
}
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", "icon-sm") Requests</a>
<div class="narrow flow" data-flow="request">
    <div class="page-head"><div><h1>Request money</h1><p>Ask another SimpleBank customer to pay you. They get a notification and can pay or decline.</p></div></div>
    <partial name="_FlowSteps" model='new FlowStepsModel(["Details", "Review", "Sent"])' />
    <form asp-action="Create" method="post" class="card flow-card" novalidate data-money-form data-no-loading>
        <div class="flow-step" data-step="1">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>
            <div class="field recipient-field">
                <label asp-for="Payer">Who should pay you?</label>
                <div class="recipient-picked" data-recipient-picked hidden></div>
                <div class="input-wrap recipient-search" data-recipient-search>
                    @Ui.Icon("search")
                    <input asp-for="Payer" class="input" placeholder="Search by name, &#64;handle or email" autocomplete="off" autocapitalize="off" spellcheck="false"
                           role="combobox" aria-expanded="false" aria-controls="recipient-results" aria-autocomplete="list" />
                    <ul class="recipient-results popover" id="recipient-results" role="listbox"></ul>
                </div>
                <span class="hint">Try &#64;alice, &#64;bob, &#64;carol or &#64;dave.</span>
                <span asp-validation-for="Payer" class="field-error"></span>
            </div>

            <partial name="_AmountField" model="new AmountFieldModel(Model.Amount, [10m, 20m, 50m, 100m])" />

            <div class="field">
                <label asp-for="Note">What's it for? <span class="optional">(optional)</span></label>
                <input asp-for="Note" class="input" maxlength="140" placeholder="For example, concert tickets" />
                <span class="hint">They'll see this note with your request.</span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-block" data-to-review>Review request</button>
        </div>

        <div class="flow-step" data-step="2" hidden>
            <div class="review">
                <span class="muted">Check the details. They aren't asked until you send it.</span>
                <div class="review-amount num" data-review-amount>$0.00</div>
                <dl class="detail-list">
                    <dt>Asking</dt><dd data-review-recipient></dd>
                    <dt>Note</dt><dd data-review-memo></dd>
                </dl>
            </div>
            <div class="flow-actions">
                <button type="button" class="btn btn-secondary btn-lg" data-back>@Ui.Icon("arrow-left", "icon-sm")Edit details</button>
                <button type="submit" class="btn btn-primary btn-lg" data-confirm-submit>Request <span class="num" data-cta-amount></span></button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script type="module" src="~/js/money-flow.js" asp-append-version="true"></script>
}
