@* Layout for signed-out pages: login, register and errors. Form on the left, a claret panel with the still rosette on the right. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
</head>
<body data-auth="0" class="auth-body">
    <partial name="_Icons" />
    <a class="sr-only" href="#main">Skip to content</a>
    <div class="auth">
        <div class="auth-form-col">
            <header class="auth-top">
                <a class="brand" href="/" aria-label="SimpleBank home"><img class="brand-mark" src="~/img/favicon.svg" alt="" /><span>SimpleBank</span></a>
                <button type="button" class="icon-btn theme-toggle" data-theme-toggle data-tip="Switch to dark mode" aria-label="Switch to dark mode">
                    <svg class="icon when-light" aria-hidden="true"><use href="#i-moon" /></svg>
                    <svg class="icon when-dark" aria-hidden="true"><use href="#i-sun" /></svg>
                </button>
            </header>
            <main id="main" class="auth-main">
                @RenderBody()
            </main>
            <footer class="auth-foot muted">SimpleBank is a class project. No real money moves here.</footer>
        </div>
        <aside class="auth-art" aria-label="About SimpleBank">
            <svg class="rosette" viewBox="-100 -100 200 200" aria-hidden="true">@Ui.Rosette()</svg>
            <h2>Banking you can read line by line.</h2>
            <p>Every account keeps a ledger you can search, so you always know where a dollar came from and where it went.</p>
            <ul class="auth-points">
                <li><span class="tick">@Ui.Icon("send", "icon-sm")</span><span><strong>Pay people by handle</strong><span>Type @@alice, check the name, then send.</span></span></li>
                <li><span class="tick">@Ui.Icon("target", "icon-sm")</span><span><strong>Save toward a goal</strong><span>Set a target and watch the progress bar fill.</span></span></li>
                <li><span class="tick">@Ui.Icon("lock", "icon-sm")</span><span><strong>Locked after 5 wrong passwords</strong><span>Sign-in pauses for five minutes to stop guessing.</span></span></li>
            </ul>
        </aside>
    </div>
    <div class="toasts" aria-live="polite"></div>
    <partial name="_Flash" />
    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
