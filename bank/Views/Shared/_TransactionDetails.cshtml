@model Transaction
@{
    var related = ViewBag.Related as Transaction;
    var isIn = Model.Amount > 0;
}
<div class="tx-detail">
    <div class="tx-detail-hero">
        <span class="tx-icon tx-icon-xl cat-@Model.Category">@Ui.Icon(Ui.TransactionIcon(Model), "icon-lg")</span>
        <div class="tx-detail-amt num @(isIn ? "pos" : "")">@Money.Signed(Model.Amount)</div>
        <div class="tx-detail-title">@Ui.TransactionTitle(Model)</div>
        <div class="muted">@Model.PostedUtc.ToLocalTime().ToString("dddd, MMMM d, yyyy 'at' h:mm tt", Money.Culture)</div>
    </div>
    <dl class="detail-list">
        <dt>Type</dt><dd>@Ui.TypeLabel(Model.Type)</dd>
        <dt>Category</dt><dd><span class="chip chip-cat cat-@Model.Category">@Model.Category</span></dd>
        <dt>Account</dt><dd>@Model.BankAccount.Name <span class="muted">@Model.BankAccount.MaskedNumber</span></dd>
        @if (related is not null)
        {
            <dt>@(isIn ? "From account" : "To account")</dt><dd>@related.BankAccount.Name</dd>
        }
        else if (Model.CounterpartyName is not null)
        {
            <dt>@(isIn ? "From" : "To")</dt><dd>@Model.CounterpartyName</dd>
        }
        <dt>Description</dt><dd>@Model.Description</dd>
        <dt>Balance after</dt><dd class="num">@Money.Format(Model.BalanceAfter)</dd>
        <dt>Reference</dt>
        <dd>
            <button type="button" class="btn btn-ghost btn-sm" data-copy="@Model.Reference" data-copy-label="@Model.Reference" aria-label="Copy reference @Model.Reference"><span class="num">@Model.Reference</span>@Ui.Icon("copy", "icon-sm")</button>
        </dd>
    </dl>
    <div class="tx-detail-actions">
        <a class="btn btn-secondary btn-block" href="/Accounts/Details/@Model.BankAccountId">Open @Model.BankAccount.Name</a>
        @if (Model.Amount < 0 && Model.Type is TransactionType.Purchase or TransactionType.BillPayment)
        {
            var half = decimal.Round(-Model.Amount / 2, 2).ToString(System.Globalization.CultureInfo.InvariantCulture);
            <a class="btn btn-secondary btn-block" href="/Requests/Create?amount=@half&note=@Uri.EscapeDataString($"Half of {Ui.TransactionTitle(Model)}")">@Ui.Icon("request", "icon-sm")Split this with someone</a>
        }
        @if (ViewBag.CounterpartyHandle is string handle)
        {
            <a class="btn btn-primary btn-block" href="/Money/Send?to=%40@handle">@(Model.Type == TransactionType.P2PReceived ? $"Send money to {Model.CounterpartyName}" : $"Send {Model.CounterpartyName} money again")</a>
        }
    </div>
</div>
