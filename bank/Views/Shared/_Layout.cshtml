<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - SimpleBank</title><link rel="stylesheet" href="~/css/site.css"/></head><body><header><nav class="nav"><a class="brand" asp-controller="Home" asp-action="Index">SimpleBank</a><div class="links">@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Dashboard" asp-action="Index">Dashboard</a><a asp-controller="Transfers" asp-action="Create">Transfer</a><a asp-controller="BillPay" asp-action="Index">Bill Pay</a>}<partial name="_LoginPartial"/></div></nav></header><main class="container">@if(TempData["Success"] is string s){<div class="alert success">@s</div>}@RenderBody()</main><footer>Educational demo only. No real banking network is connected.</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>