@model TransactionResultsModel
@using Microsoft.AspNetCore.Http.Extensions
@{
    var r = Model.Results;
    string Link(int page)
    {
        var qb = new QueryBuilder(Model.Query.ToRouteValues(page: page));
        return Context.Request.Path + qb.ToQueryString().ToString();
    }
    // Compact page window: 1 … 4 5 [6] 7 8 … 20
    var pages = new SortedSet<int> { 1, r.TotalPages };
    for (var p = r.Page - 2; p <= r.Page + 2; p++) if (p >= 1 && p <= r.TotalPages) pages.Add(p);
}
@if (r.TotalCount > 0)
{
    <nav class="pager" aria-label="Pagination">
        <span class="pager-info">Showing <strong class="num">@r.FirstItem–@r.LastItem</strong> of <strong class="num">@r.TotalCount.ToString("N0")</strong></span>
        @if (r.TotalPages > 1)
        {
            <div class="pager-pages">
                <a href="@Link(r.Page - 1)" class="@(r.HasPrevious ? "" : "disabled")" aria-label="Previous page" data-page-link>@Ui.Icon("chevron-left", "icon-sm")</a>
                @{ var prev = 0; }
                @foreach (var p in pages)
                {
                    if (p - prev > 1) { <span class="pg-num" aria-hidden="true">…</span> }
                    if (p == r.Page) { <span aria-current="page">@p</span> }
                    else { <a class="pg-num" href="@Link(p)" data-page-link>@p</a> }
                    prev = p;
                }
                <a href="@Link(r.Page + 1)" class="@(r.HasNext ? "" : "disabled")" aria-label="Next page" data-page-link>@Ui.Icon("chevron-right", "icon-sm")</a>
            </div>
        }
    </nav>
}
