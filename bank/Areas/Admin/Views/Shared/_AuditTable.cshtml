@model IEnumerable<AuditLog>
@if (!Model.Any())
{
    <div class="empty"><div class="empty-icon">@Ui.Icon("history")</div><h3>No events yet</h3><p>Sign-ins and admin actions are recorded here.</p></div>
}
else
{
    <div class="table-wrap">
        <table class="table table-stack">
            <thead><tr><th>When</th><th>Who</th><th>Action</th><th class="hide-sm">Details</th><th class="hide-sm">IP</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="num nowrap" data-label="When">@a.CreatedUtc.ToLocalTime().ToString("MMM d, h:mm tt", Money.Culture)</td>
                        <td data-label="Who">@(a.ActorName ?? "System")</td>
                        <td data-label="Action"><span class="chip @(a.Action.StartsWith("account.") ? "chip-tan" : a.Action.Contains("lock") ? "chip-neg" : "")">@a.Action</span></td>
                        <td class="hide-sm" data-label="Details">@a.Details</td>
                        <td class="hide-sm num muted" data-label="IP">@a.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
