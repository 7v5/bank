@model TransactionResultsModel
@{
    var u = (ApplicationUser)ViewBag.Customer;
    var accounts = (List<BankAccount>)ViewBag.Accounts;
    var locked = (bool)ViewBag.IsLocked;
    var audit = (List<AuditLog>)ViewBag.Audit;
    ViewData["Title"] = u.FullName;
    ViewData["DetailUrl"] = "/Admin/Ledger/Details/";
}
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", "icon-sm") Customers</a>

<div class="page-head">
    <div class="user-cell">
        <span class="avatar avatar-lg" style="--c:@u.AvatarColor">@u.Initials</span>
        <div>
            <h1>@u.FullName</h1>
            <p>&#64;@u.Handle, @u.Email. Customer since @u.CreatedUtc.ToLocalTime().ToString("MMMM d, yyyy", Money.Culture).</p>
        </div>
    </div>
    <form asp-action="Lock" asp-route-id="@u.Id" method="post">
        <input type="hidden" name="locked" value="@(!locked ? "true" : "false")" />
        @if (locked)
        {
            <button class="btn btn-secondary" type="submit">@Ui.Icon("unlock", "icon-sm")Unlock sign-in</button>
        }
        else
        {
            <button class="btn btn-soft-danger" type="submit" data-confirm="Lock @u.FullName out? They'll be signed out immediately.">@Ui.Icon("lock", "icon-sm")Lock sign-in</button>
        }
    </form>
</div>

@if (locked)
{
    <div class="alert alert-neg" style="margin-bottom:var(--space-4)">@Ui.Icon("lock")<span>This customer can't sign in until you unlock them.</span></div>
}

<div class="acct-grid">
    @foreach (var a in accounts)
    {
        <article class="card card-pad stack" style="gap:10px;@(a.IsActive ? "" : "opacity:.6")">
            <div class="row">
                <span class="acct-icon">@Ui.Icon(a.Type == AccountType.Goal ? "target" : Ui.AccountIcon(a), "icon-sm")</span>
                <div style="flex:1;min-width:0"><strong>@a.Name</strong><div class="muted num" style="font-size:.84rem">@a.AccountNumber</div></div>
                @if (a.IsFrozen) { <span class="chip chip-warn">@Ui.Icon("snowflake", "icon-sm")Frozen</span> }
                @if (!a.IsActive) { <span class="chip">Closed</span> }
            </div>
            <div class="acct-balance num">@Money.Format(a.Balance)</div>
            @if (a.IsActive)
            {
                <div class="row row-wrap">
                    <form asp-action="Freeze" asp-route-id="@u.Id" method="post">
                        <input type="hidden" name="accountId" value="@a.Id" /><input type="hidden" name="frozen" value="@(!a.IsFrozen ? "true" : "false")" />
                        <button class="btn btn-secondary btn-sm" type="submit">@Ui.Icon("snowflake", "icon-sm")@(a.IsFrozen ? "Unfreeze" : "Freeze")</button>
                    </form>
                    <button class="btn btn-ghost btn-sm" type="button" data-drawer-open="adjust-@a.Id">@Ui.Icon("sliders", "icon-sm")Adjust</button>
                </div>
                <div class="drawer" id="adjust-@a.Id" role="dialog" aria-modal="true" aria-label="Adjust balance" aria-hidden="true">
                    <div><div class="sheet-grip"></div><div class="drawer-head"><h2>Adjust @a.Name</h2><button type="button" class="icon-btn" data-drawer-close aria-label="Close">@Ui.Icon("x")</button></div></div>
                    <form class="drawer-body form" asp-action="Adjust" asp-route-id="@u.Id" method="post">
                        <input type="hidden" name="accountId" value="@a.Id" />
                        <p class="muted">Posts a ledger line marked as a bank adjustment. The customer is notified and the action is audited.</p>
                        <div class="segmented" role="radiogroup" aria-label="Direction">
                            <label class="seg-radio" role="radio" aria-checked="true" aria-selected="true"><input class="sr-only" type="radio" name="direction" value="credit" checked />Credit</label>
                            <label class="seg-radio" role="radio" aria-checked="false" aria-selected="false"><input class="sr-only" type="radio" name="direction" value="debit" />Debit</label>
                        </div>
                        <div class="field"><label for="amt-@a.Id">Amount</label><input id="amt-@a.Id" name="amount" class="input num" inputmode="decimal" required placeholder="25.00" /></div>
                        <div class="field"><label for="why-@a.Id">Reason</label><input id="why-@a.Id" name="reason" class="input" required minlength="5" maxlength="200" placeholder="Refund of duplicate charge" /></div>
                        <button class="btn btn-primary" type="submit">Post adjustment</button>
                    </form>
                </div>
            }
        </article>
    }
</div>

<section class="card card-pad" style="margin-top:var(--space-5)">
    <div class="card-head"><h2>Transactions</h2></div>
    <div data-results-host><partial name="_TransactionResults" model="Model" /></div>
</section>

<section class="card card-pad" style="margin-top:var(--space-5)">
    <div class="card-head"><h2>Audit trail</h2></div>
    <partial name="_AuditTable" model="audit" />
</section>

<partial name="_TxDrawer" />
@section Scripts {
    <script type="module" src="~/js/transactions.js" asp-append-version="true"></script>
    <script type="module">
        document.querySelectorAll(".drawer .segmented").forEach((seg) => seg.addEventListener("change", async () => {
            seg.querySelectorAll("label").forEach((l) => { const on = l.querySelector("input").checked; l.setAttribute("aria-checked", on); l.setAttribute("aria-selected", on); });
            (await import("/js/ui.js")).syncSegmented(seg);
        }));
        document.addEventListener("click", (e) => { if (e.target.closest("[data-drawer-open]")) setTimeout(async () => document.querySelectorAll(".drawer.open .segmented").forEach((await import("/js/ui.js")).syncSegmented), 60); });
    </script>
}
