@model PagedResult<CustomerRow>
@inject TimeProvider Clock
@{
    ViewData["Title"] = "Customers";
    var q = ViewBag.Q as string;
    var now = Clock.GetUtcNow().UtcDateTime;
}
<div class="page-head"><div><h1>Customers</h1><p>@Model.TotalCount customers. Select View customer to see their accounts, freeze an account or post an adjustment.</p></div></div>

<form method="get" class="admin-toolbar" role="search">
    <div class="input-wrap">@Ui.Icon("search")<input class="input" type="search" name="q" value="@q" placeholder="Search by name, handle or email" aria-label="Search customers" /></div>
    <button class="btn btn-secondary" type="submit">Search</button>
</form>

<section class="card card-pad">
    @if (Model.TotalCount == 0)
    {
        <div class="empty"><div class="empty-icon">@Ui.Icon("users")</div><h3>No customers match</h3><p>Try a different search.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-stack">
                <thead><tr><th>Customer</th><th class="r">Accounts</th><th class="r">Balance</th><th class="hide-sm">Last activity</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td class="cell-main">
                                <div class="user-cell">
                                    <span class="avatar avatar-sm" style="--c:@r.User.AvatarColor" aria-hidden="true">@r.User.Initials</span>
                                    <div><strong>@r.User.FullName</strong><small>&#64;@r.User.Handle, @r.User.Email</small></div>
                                </div>
                            </td>
                            <td class="r num" data-label="Accounts">@r.Accounts</td>
                            <td class="r num" data-label="Balance">@Money.Format(r.Balance)</td>
                            <td class="hide-sm muted" data-label="Last activity">@(r.LastActivity is { } w ? Ui.Ago(w, now) : "Never")</td>
                            <td data-label="Status">@if (r.IsLocked) { <span class="chip chip-neg">@Ui.Icon("lock", "icon-sm")Locked</span> } else { <span class="chip chip-pos">Active</span> }</td>
                            <td class="r"><a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@r.User.Id" aria-label="View @r.User.FullName">View customer</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="Pagination">
                <span class="pager-info">Page <strong class="num">@Model.Page</strong> of <strong class="num">@Model.TotalPages</strong></span>
                <div class="pager-pages">
                    <a class="@(Model.HasPrevious ? "" : "disabled")" asp-route-q="@q" asp-route-page="@(Model.Page - 1)" aria-label="Previous page">@Ui.Icon("chevron-left", "icon-sm")</a>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page) { <span aria-current="page">@p</span> } else { <a class="pg-num" asp-route-q="@q" asp-route-page="@p">@p</a> }
                    }
                    <a class="@(Model.HasNext ? "" : "disabled")" asp-route-q="@q" asp-route-page="@(Model.Page + 1)" aria-label="Next page">@Ui.Icon("chevron-right", "icon-sm")</a>
                </div>
            </nav>
        }
    }
</section>
