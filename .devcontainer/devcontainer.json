{
  "name": "SimpleBank",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "postCreateCommand": "npm install -g @google/gemini-cli && dotnet restore SimpleBank.slnx",
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": { "label": "SimpleBank", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"]
    }
  }
}
